# StudentTech Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studenttech
DB_HOST=localhost
DB_PORT=5432
DB_NAME=studenttech
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
