  },
  "homepage": "https://github.com/Junaidsawand/StudentTech#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "pg-mem": "^3.0.14",
    "supertest": "^7.3.0"
  }
